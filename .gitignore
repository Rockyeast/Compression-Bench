# Public release allowlist. Research, learning, credentials and model artifacts stay local.
/*
!/.gitignore
!/README.md
!/shared/
!/tasks/
!/scripts/

/tasks/*
!/tasks/quantize-qwen3.8-27b-12g/
!/tasks/quantize-qwen3.8-27b-16g/
!/tasks/quantize-qwen3.8-27b-24g/
!/tasks/quantize-qwen3.8-27b-32g/

/scripts/*
!/scripts/debug-model-compose.yaml
!/scripts/build_agent_base.sh

# Generated files and credentials are never part of the release.
__pycache__/
*.pyc
*.safetensors
*.pt
*.pth
*.ckpt
.env
.env.*
*.pem
*.key
